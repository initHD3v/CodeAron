# CodeAron Project Configuration
# Dokumentasi lengkap: https://github.com/initHD3v/CodeAron/wiki/Configuration

version: "1.0"

# Model Configuration
model:
  # Default model untuk inference
  default: "mlx-community/Qwen2.5-Coder-7B-Instruct-4bit"
  # Fallback model jika default gagal
  fallback: "mlx-community/DeepSeek-Coder-V2-Lite-Instruct-4bit"

# Memory Settings
memory:
  # Maximum messages dalam short-term memory
  max_short_term: 10
  # Jumlah hasil pencarian vector
  vector_search_limit: 5

# Tool Configuration
tools:
  shell:
    # Commands yang auto-execute tanpa konfirmasi
    auto_confirm:
      - ls
      - pwd
      - head
      - tail
      - echo
      - grep
    # Commands yang diblokir sepenuhnya
    blocked:
      - rm -rf /
      - sudo
      - mkfs
      - dd
    # Cooldown antar commands (detik)
    cooldown_seconds: 2.0
    # Maximum failures sebelum circuit breaker aktif
    max_consecutive_failures: 5
  
  file:
    # Maximum file size untuk edit (bytes)
    max_file_size: 1048576  # 1MB
    # Auto backup sebelum modify
    auto_backup: true

# Directories yang diabaikan saat indexing
ignored_dirs:
  - .git
  - node_modules
  - .venv
  - venv
  - __pycache__
  - build
  - dist
  - .idea
  - .vscode
  - coverage
  - .pytest_cache

# Analysis Settings
analysis:
  # Maximum tokens untuk context
  max_context_tokens: 24000
  # Temperature untuk inference (0.0 - 1.0)
  temperature: 0.2
  # Maximum iterations per request
  max_iterations: 5
